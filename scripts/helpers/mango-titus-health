	# that are wrong for mango-titus Wayland. Mirror mango-titus-check-deps instead.

	emit_dep_cmd dependency-mangowm "mangowm" mango mangowm required
	emit_dep_cmd dependency-quickshell "Quickshell" qs quickshell required
	emit_dep_cmd dependency-wallpaper "Wallpaper daemon" awww swww required
	emit_dep_cmd dependency-swayidle "swayidle" swayidle required
	emit_dep_cmd dependency-swaylock "swaylock" swaylock swaylock-effects required
	emit_dep_cmd dependency-nmcli "NetworkManager (nmcli)" nmcli required
	emit_dep_cmd dependency-terminal "Terminal" alacritty kitty ghostty foot xterm required
	emit_dep_cmd dependency-wlr-randr "wlr-randr" wlr-randr optional
	emit_dep_cmd dependency-wl-copy "wl-clipboard" wl-copy optional
	emit_dep_cmd dependency-cliphist "cliphist" cliphist optional
	emit_dep_cmd dependency-flameshot "Flameshot" flameshot optional
	emit_dep_cmd dependency-brightnessctl "brightnessctl" brightnessctl optional
	emit_dep_cmd dependency-playerctl "playerctl" playerctl optional
