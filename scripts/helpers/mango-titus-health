scan_user() {
	local boot_work

	emit_meta overview info scan-user "User scan" "Running" "Read-only session and resource diagnostics"
	scan_identity
	scan_memory
	scan_load
	scan_storage
	scan_user_services
	# Boot/journal is often readable without root (systemd-journal/wheel); fill Boot & Kernel
	# even when the privileged scan is skipped or cancelled.
	boot_work=$(mktemp -d)
	scan_boot_logs "$boot_work"
	rm -rf "$boot_work"
	scan_desktop
