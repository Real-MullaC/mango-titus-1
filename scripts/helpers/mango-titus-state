#!/usr/bin/env bash
# Tag/window state bridge for Quickshell panel on mangowm.
# Uses current mmsg JSON IPC (get focusing-client / get all-tags);
# falls back to legacy mmsg -g flags when available.
# Emits current= as a 0-based workspace index (matches Quickshell Repeater index).
set -euo pipefail

find_mango_socket() {
	if [[ -n "${MANGO_INSTANCE_SIGNATURE:-}" && -S "${MANGO_INSTANCE_SIGNATURE}" ]]; then
		printf '%s\n' "$MANGO_INSTANCE_SIGNATURE"
		return 0
	fi

	local uid runtime mango_pid sock
	uid=$(id -u)
	runtime=${XDG_RUNTIME_DIR:-/run/user/$uid}
	mango_pid=$(pgrep -n -x mango 2>/dev/null || true)
	if [[ -n "$mango_pid" && -S "$runtime/mango-${mango_pid}.sock" ]]; then
		printf '%s\n' "$runtime/mango-${mango_pid}.sock"
		return 0
	fi

	sock=$(ls -1t "$runtime"/mango-*.sock 2>/dev/null | head -n1 || true)
	if [[ -n "$sock" && -S "$sock" ]]; then
		printf '%s\n' "$sock"
		return 0
	fi
	return 1
}

# Run mmsg with a resolved socket when qs/helpers lack the compositor env.
with_mmsg() {
	local sock
	if sock=$(find_mango_socket); then
		MANGO_INSTANCE_SIGNATURE=$sock "$@"
	else
		"$@"
	fi
}

json_title() {
	# stdin: focusing-client JSON → stdout title or empty
	python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(data, dict) or data.get("error"):
    sys.exit(0)
title = (data.get("title") or "").strip()
if title:
    print(title[:120])
' 2>/dev/null || true
}

json_current_tag() {
	# stdin: all-tags JSON → stdout 0-based active tag index
	python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print(0)
    sys.exit(0)
if not isinstance(data, dict) or data.get("error"):
    print(0)
    sys.exit(0)
tags = []
for block in data.get("all_tags") or []:
    tags = block.get("tags") or []
    break
index = 0
for tag in tags:
    if tag.get("is_active"):
        raw = int(tag.get("index") or 1)
        index = max(0, raw - 1)
        break
print(index)
' 2>/dev/null || printf '0\n'
}

looks_like_json_error() {
	local text=$1
	[[ "$text" == \{*\"error\"* ]] || [[ "$text" == \{\"error\":* ]]
}

print_state() {
	local current=0
	local title=Desktop
	local names="1|2|3|4|5|6|7|8|9"

	if command -v mmsg >/dev/null 2>&1; then
		local focused_json tags_json parsed focused raw

		focused_json=$(with_mmsg mmsg get focusing-client 2>/dev/null || true)
		if [[ -n "${focused_json:-}" ]] && ! looks_like_json_error "$focused_json"; then
			if command -v python3 >/dev/null 2>&1; then
				parsed=$(printf '%s' "$focused_json" | json_title || true)
				[[ -n "${parsed:-}" ]] && title=$parsed
			fi
		elif [[ "${focused_json:-}" == *'"no focused client"'* ]]; then
			title=Desktop
		else
			# Legacy flag IPC (older mmsg): "Virtual-1 title ~"
			focused=$(with_mmsg mmsg -g -c 2>/dev/null | head -n1 || true)
			if [[ -n "${focused:-}" ]] && ! looks_like_json_error "$focused"; then
				title=$(printf '%s' "$focused" | sed -E 's/^[^ ]+ title //;s/^title:[[:space:]]*//;s/^appid:[[:space:]]*//' | head -c 120)
				[[ -n "$title" ]] || title=Desktop
			fi
		fi

		tags_json=$(with_mmsg mmsg get all-tags 2>/dev/null || true)
		if [[ -n "${tags_json:-}" ]] && ! looks_like_json_error "$tags_json" && command -v python3 >/dev/null 2>&1; then
			current=$(printf '%s' "$tags_json" | json_current_tag)
		else
			raw=$(with_mmsg mmsg -g -t 2>/dev/null || true)
			if [[ -n "${raw:-}" ]] && ! looks_like_json_error "$raw"; then
				if [[ "$raw" =~ current[=:]([0-9]+) ]]; then
					current="${BASH_REMATCH[1]}"
					if ((current >= 1)); then
						current=$((current - 1))
					fi
				fi
			fi
		fi
	fi

	# Never surface compositor/IPC errors as the window title.
	if looks_like_json_error "$title"; then
		title=Desktop
	fi

	printf 'current=%s\n' "$current"
	printf 'names=%s\n' "$names"
	printf 'title=%s\n' "$title"
	printf 'status=\n'
	printf '\n'
}

switch_tag() {
	# Argument is 0-based Quickshell index; mmsg view tags are 1-based.
	local index=${1:-0}
	local tag=$((index + 1))
	if command -v mmsg >/dev/null 2>&1; then
		with_mmsg mmsg dispatch "view,$tag" >/dev/null 2>&1 \
			|| with_mmsg mmsg -d "view,$tag" >/dev/null 2>&1 \
			|| true
	fi
}

case "${1:-watch}" in
watch)
	while true; do
		print_state
		sleep 0.5
	done
	;;
switch)
	switch_tag "${2:-0}"
	print_state
	;;
show | state)
	print_state
	;;
*)
	printf 'usage: %s {watch|switch <index>|show}\n' "$0" >&2
	exit 1
	;;
esac
