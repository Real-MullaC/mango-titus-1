#!/usr/bin/env bash
# Named display profiles for mangowm (wlr-randr), same ownership model as dwm-display-profile.
set -euo pipefail

profile_dir="${MANGO_DISPLAY_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/mango-titus/display-profiles}"

usage() {
	cat <<EOF
Usage:
  mango-titus-display-profile dir
  mango-titus-display-profile list
  mango-titus-display-profile apply <profile>
  mango-titus-display-profile template

Profiles live in:
  $profile_dir

Each non-empty, non-comment line:
  OUTPUT wlr-randr-options...
Example:
  HDMI-A-1 --on --mode 1920x1080 --pos 0,0
  eDP-1 --off
EOF
}

need_wlr() {
	command -v wlr-randr >/dev/null 2>&1 || {
		printf 'mango-titus-display-profile: missing wlr-randr\n' >&2
		return 1
	}
}

profile_path() {
	local name=$1
	case "$name" in
	"" | */* | *..*)
		printf 'invalid profile name: %s\n' "$name" >&2
		return 1
		;;
	esac
	if [[ $name == *.conf ]]; then
		printf '%s/%s\n' "$profile_dir" "$name"
	else
		printf '%s/%s.conf\n' "$profile_dir" "$name"
	fi
}

cmd_dir() {
	mkdir -p "$profile_dir"
	printf '%s\n' "$profile_dir"
}

cmd_list() {
	mkdir -p "$profile_dir"
	find "$profile_dir" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' 2>/dev/null | sort
}

cmd_template() {
	cat <<'EOF'
# Example mangowm display profile (wlr-randr)
# HDMI-A-1 --on --mode 1920x1080 --pos 0,0
# eDP-1 --off
EOF
}

cmd_apply() {
	need_wlr
	local path
	path=$(profile_path "$1")
	[[ -f "$path" ]] || {
		printf 'profile not found: %s\n' "$path" >&2
		return 1
	}
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
		# shellcheck disable=SC2086
		wlr-randr --output $line
	done <"$path"
}

case "${1:-}" in
dir) cmd_dir ;;
list) cmd_list ;;
template) cmd_template ;;
apply)
	[[ -n "${2:-}" ]] || {
		usage >&2
		exit 1
	}
	cmd_apply "$2"
	;;
*)
	usage >&2
	exit 1
	;;
esac
